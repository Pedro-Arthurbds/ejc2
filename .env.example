# Copie este arquivo para ".env" e preencha. O arquivo .env não deve ir para o GitHub.

# Senha do painel /admin (obrigatória em produção)
ADMIN_PASSWORD=troque-esta-senha

# Total de vagas (uma por inscrito)
VAGAS=120

# Porta (opcional)
PORT=3000

# Planilha do Google (opcional). Deixe em branco para desligar.
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=

# Pagamento por Pix (opcional). Só liga se PIX_CHAVE e VALOR_POR_PESSOA estiverem preenchidos.
# Chave Pix: e-mail, CPF/CNPJ (só números), telefone no formato +5527999990000, ou chave aleatória.
PIX_CHAVE=
# Nome que aparece para quem paga (até 25 letras) e cidade do recebedor
PIX_RECEBEDOR=EJC Itarana
PIX_CIDADE=Itarana
# Valor do ingresso por pessoa, em reais (ex.: 20 ou 20,50)
VALOR_POR_PESSOA=

# Banco Postgres (o Render preenche sozinho). Sem isso, o sistema usa um arquivo SQLite local.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
